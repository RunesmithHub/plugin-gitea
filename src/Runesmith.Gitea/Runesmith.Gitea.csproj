<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Gitea and Forgejo in Runesmith: signing in to gitea.com, Codeberg and other Gitea and Forgejo servers, cloning, links and pull requests.</Description>
    <!-- Flags text users see that is written in the code instead of locales/en. -->
    <RunesmithLocalize>true</RunesmithLocalize>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Runesmith.Gitea.Contracts\Runesmith.Gitea.Contracts.csproj" />
  </ItemGroup>
  <!-- Runesmith supplies these when it loads the plugin, so none of them is copied next to it. -->
  <ItemGroup>
    <PackageReference Include="Runesmith.Sdk" ExcludeAssets="runtime" />
    <PackageReference Include="HammerUI" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Runesmith.Gitea.Tests" />
  </ItemGroup>
</Project>
