<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Versions listed here also apply to packages that come in transitively, so a vulnerable transitive package can be raised here. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
  </PropertyGroup>
  <ItemGroup Label="Runesmith">
    <PackageVersion Include="Runesmith.Sdk" Version="0.2.0" />
    <PackageVersion Include="Runesmith.Text" Version="0.2.0" />
    <PackageVersion Include="Runesmith.LanguageServices" Version="0.2.0" />
    <!-- The contracts of the Git plugin, which this plugin depends on; the hub publishes them to its feed with each release of the Git plugin. -->
    <PackageVersion Include="RunesmithHub.Runesmith.Git.Contracts" Version="0.2.0" />
  </ItemGroup>
  <ItemGroup Label="User interface">
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="HammerUI" Version="0.1.1" />
  </ItemGroup>
  <ItemGroup Label="Composition">
    <!-- Runesmith shares these with its plugins, so they stay at the versions Runesmith loads. -->
    <PackageVersion Include="System.Composition.AttributedModel" Version="10.0.12" />
    <PackageVersion Include="System.Composition.Convention" Version="10.0.12" />
    <PackageVersion Include="System.Composition.Hosting" Version="10.0.12" />
    <PackageVersion Include="System.Composition.Runtime" Version="10.0.12" />
    <PackageVersion Include="System.Composition.TypedParts" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
